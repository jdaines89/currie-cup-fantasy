# Everything below is optional. The app works with none of it set.

# Where the SQLite file lives. Defaults to ./currie-cup.db
DATABASE_PATH=./currie-cup.db

# Which data provider to pull from: "thesportsdb" (default, free, no key) or "apisports".
DATA_PROVIDER=thesportsdb

# TheSportsDB free public test key. "3" is their documented no-signup key.
THESPORTSDB_KEY=3

# Only needed if you set DATA_PROVIDER=apisports. Free tier is 100 requests/day.
# Note: API-Sports rugby has no players endpoint, so it can only feed
# fixtures, results and standings -- not the player fantasy game.
APISPORTS_KEY=

# Season to operate on.
SEASON=2026
